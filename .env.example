SECRET_KEY=replace-with-a-generated-random-key-of-at-least-32-characters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=netflix_clone
MYSQL_USER=netflix_app
MYSQL_PASSWORD=replace-with-a-unique-password
APP_ENV=development
# Optional full connection URL instead of MYSQL_* variables:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/netflix_clone
# For public HTTPS hosting set APP_ENV=production and SECURE_COOKIES=true
SECURE_COOKIES=false
